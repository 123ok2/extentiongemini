{
  "manifest_version": 3,
  "name": "Gemini & ChatGPT Study Exporter",
  "short_name": "AI Study Export",
  "version": "2.6.0",
  "description": "Tải cuộc trò chuyện hoặc 1 phần đoạn chat trên Gemini và ChatGPT (giữ nguyên công thức toán LaTeX, bảng biểu, code)",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}